# ---- Project-specific ----
# Large binary raster files go to Zenodo (not GitHub, per Elsevier data
# policy). CSVs and metadata are small and stay tracked for reproducibility.
data/raw/*.tif
data/raw/*.tiff
data/interim/*.tif
data/interim/*.tiff
data/external/*.tif
data/external/*.tiff

